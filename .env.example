# Copy to `.env` for local overrides. All are optional.

# GitHub login to scan (defaults to "archont561").
GITHUB_USER=archont561

# Personal access token to raise GitHub API rate limits.
# In GitHub Actions this is provided automatically as secrets.GITHUB_TOKEN.
# GITHUB_TOKEN=

# Include forked repositories in the mosaic (default: false).
# INCLUDE_FORKS=true

# Include the profile repo itself in the mosaic (default: false).
# INCLUDE_SELF=true
