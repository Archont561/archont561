---
import { AspectRatio, Badge, Ribbon } from "webcoreui/astro";
import data from "../data/repos.json";
import type { Repo } from "../../scripts/scan-repos";
import { languageColor } from "../lib/languageColors";

interface Props {
  /** Limit the number of tiles rendered (0 = all). */
  limit?: number;
  /** Show the language filter bar. */
  filters?: boolean;
}

const { limit = 0, filters = true } = Astro.props;

const repos = (data.repos as Repo[]).slice(0, limit > 0 ? limit : undefined);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (img: string) => (/^https?:\/\//.test(img) ? img : `${base}/${img}`);

const languages = data.languages as string[];
const totalStars = repos.reduce((sum, r) => sum + r.stars, 0);
const generated = new Date(data.generatedAt);
const nf = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
---

<section aria-label="GitHub repository mosaic" class="not-content">
  <div class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm op-80" role="status">
    <span><strong class="text-accent-high">{repos.length}</strong> repositories</span>
    <span aria-hidden="true" class="op-40">·</span>
    <span><strong class="text-accent-high">{languages.length}</strong> languages</span>
    <span aria-hidden="true" class="op-40">·</span>
    <span><strong class="text-accent-high">{totalStars}</strong> stars</span>
    <span aria-hidden="true" class="op-40">·</span>
    <span class="op-60">scanned {nf.format(generated)}</span>
  </div>

  {
    filters && languages.length > 0 && (
      <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filter repositories by language">
        <button class="mosaic-chip mosaic-chip-active" data-filter="all" type="button">
          All
        </button>
        {languages.map((lang) => (
          <button class="mosaic-chip" data-filter={lang} type="button">
            <span class="h-2 w-2 rounded-full" style={`background:${languageColor(lang)}`} />
            {lang}
          </button>
        ))}
      </div>
    )
  }

  <ul
    id="mosaic-grid"
    class="grid list-none gap-4 p-0 m-0 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      repos.map((repo) => (
        <li data-language={repo.language ?? "Other"} class="m-0">
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${repo.name} on GitHub`}
            class="group relative block overflow-hidden rounded-xl border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-black)] no-underline transition-transform duration-200 ease-out hover:-translate-y-1 hover:border-accent focus-visible:-translate-y-1 focus-visible:border-accent"
          >
            {repo.archived && (
              <Ribbon theme="warning" className="tile-ribbon">
                Archived
              </Ribbon>
            )}
            {!repo.archived && repo.isTemplate && (
              <Ribbon theme="info" className="tile-ribbon">
                Template
              </Ribbon>
            )}
            <AspectRatio ratio="2:1">
              <img
                src={resolve(repo.image)}
                alt={`Social preview for ${repo.fullName}`}
                loading="lazy"
                decoding="async"
                width="1200"
                height="600"
                class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
              />
            </AspectRatio>
            <div class="absolute inset-x-0 bottom-0 flex flex-col gap-2 bg-gradient-to-t from-black/92 via-black/55 to-transparent p-4 pt-10 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
              <div class="flex items-center justify-between gap-2">
                <h3 class="m-0 text-base font-600 text-white leading-tight">{repo.name}</h3>
                {repo.stars > 0 && (
                  <span class="shrink-0 text-sm text-amber-300" title={`${repo.stars} stars`}>
                    ★ {repo.stars}
                  </span>
                )}
              </div>
              {repo.description && (
                <p class="m-0 line-clamp-2 text-sm text-white/85">{repo.description}</p>
              )}
              <div class="flex flex-wrap items-center gap-1.5">
                {repo.language && (
                  <Badge small rounded>
                    <span
                      class="mr-1 inline-block h-2 w-2 rounded-full align-middle"
                      style={`background:${languageColor(repo.language)}`}
                    />
                    {repo.language}
                  </Badge>
                )}
                {repo.topics.slice(0, 3).map((topic) => (
                  <Badge small rounded theme="outline">
                    {topic}
                  </Badge>
                ))}
              </div>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  {
    repos.length === 0 && (
      <p class="op-70">
        No repositories found yet. Run <code>bun run scan</code> to populate the mosaic.
      </p>
    )
  }
</section>

<script>
  // Language filtering — progressive enhancement, no framework needed.
  const chips = document.querySelectorAll<HTMLButtonElement>(".mosaic-chip");
  const items = document.querySelectorAll<HTMLLIElement>("#mosaic-grid > li");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.classList.toggle("mosaic-chip-active", c === chip));
      items.forEach((item) => {
        const show = filter === "all" || item.dataset.language === filter;
        item.style.display = show ? "" : "none";
      });
    });
  });
</script>
